# Copier ce fichier en .env et renseigner tes propres valeurs.
# .env est ignoré par git — ne jamais committer de vraies valeurs.

# --- Connexion IBKR TWS / IB Gateway (config/settings.py) ---
IBKR_HOST=127.0.0.1
# Port de l'API TWS/Gateway : dépend de ta configuration (paper/live, TWS/Gateway).
# Voir la documentation IBKR pour la valeur correspondant à ton installation.
IBKR_PORT=
IBKR_CLIENT_ID=15

# --- Notifications Telegram (strategies/telegram_notify.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
